{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext"],
    "types": ["vitest/globals", "node"],
    "paths": {
      "@mmds/browser-text-metrics": [
        "../packages/mmds-browser-text-metrics/src/index.ts"
      ],
      "@mmds/browser-text-metrics/*": [
        "../packages/mmds-browser-text-metrics/src/*.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../packages/mmds-browser-text-metrics/src/mmds-wasm-shim.d.ts"
  ]
}
