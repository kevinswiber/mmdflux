{
  "name": "@mmds/browser-text-metrics",
  "version": "0.2.0",
  "type": "module",
  "description": "Browser-side adapter for @mmds/wasm dynamic text metrics",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./main-thread": {
      "types": "./dist/main-thread.d.ts",
      "import": "./dist/main-thread.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./worker-protocol": {
      "types": "./dist/worker-protocol.d.ts",
      "import": "./dist/worker-protocol.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./prepare": {
      "types": "./dist/prepare.d.ts",
      "import": "./dist/prepare.js"
    },
    "./css-font": {
      "types": "./dist/css-font.d.ts",
      "import": "./dist/css-font.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "import": "./dist/routing.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "biome check",
    "fmt": "biome check --write",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mmds",
    "mmdflux",
    "diagram",
    "text-metrics",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinswiber/mmdflux.git",
    "directory": "packages/mmds-browser-text-metrics"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@mmds/wasm": "^2.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^25.2.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
